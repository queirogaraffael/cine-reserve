              "listen": "prerequest",
              "script": {
                "exec": [
                  "let userData = {\r",
                  "  \"username\": \"raffael123\",\r",
                  "  \"name\": \"Raffael Queiroga\",\r",
                  "  \"email\": \"raffaelqueirogaa@gmail.com\",\r",
                  "  \"password\": \"senhaSegura123\",\r",
                  "  \"dataJoined\": \"2025-10-09\",\r",
                  "  \"birthdate\": \"2000-05-12\",\r",
                  "  \"category\": \"REGULAR\"\r",
                  "};\r",
                  "\r",
                  "pm.sendRequest({\r",
                  "    url: 'http://localhost:8080/api/users',\r",
                  "    method: 'POST',\r",
                  "    header: {\r",
                  "        'Content-Type': 'application/json'\r",
                  "    },\r",
                  "    body: {\r",
                  "        mode: 'raw',\r",
                  "        raw: JSON.stringify(userData)\r",
                  "    }\r",
                  "}, function (err, res) {\r",
                  "    if (err) {\r",
                  "        console.error(\"Erro ao criar usuário:\", err);\r",
                  "    } else {\r",
                  "        console.log(\"Usuário criado com sucesso:\", res.json());\r",
                  "        pm.environment.set(\"createdUserId\", res.json().id);\r",
                  "    }\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code é 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Resposta contém token e refreshToken\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property(\"token\");\r",
                  "    pm.expect(jsonData).to.have.property(\"refreshToken\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Token é um JWT válido\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.token.split('.').length).to.eql(3); \r",
                  "});\r",
                  "\r",
                  "pm.test(\"RefreshToken não está vazio\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.refreshToken).to.not.be.empty;\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"authToken\", pm.response.json().token);\r",
                  "pm.environment.set(\"refreshToken\", pm.response.json().refreshToken);\r",
                  "\r",
                  "var jsonData = pm.response.json();\r",
                  "pm.environment.set(\"authToken\", jsonData.token);\r",
                  "pm.environment.set(\"refreshToken\", jsonData.refreshToken);\r",
                  "\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
