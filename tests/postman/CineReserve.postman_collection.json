          "name": "Criar pagamento PIX",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "",
                  "    if (jsonData.paymentId && jsonData.pixCopiaECola) {",
                  "        pm.collectionVariables.set(\"lastPaymentId\", jsonData.paymentId);",
                  "        console.log(\"Payment ID de Pix salvo: \" + jsonData.paymentId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"paymentMethod\": \"PIX\",\n    \"paymentDetails\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/payments/purchases/:purchaseId",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "payments",
                "purchases",
                ":purchaseId"
              ],
              "variable": [
                {
                  "key": "purchaseId",
                  "value": ""
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Criar pagamento CARTÃO",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const numCartao = pm.environment.get(\"numero_cartao\");",
                  "const mesExp = pm.environment.get(\"mes_expiracao\");",
                  "const anoExp = pm.environment.get(\"ano_expiracao\");",
                  "const cvv = pm.environment.get(\"cvv_cartao\");",
                  "const nomeTitular = pm.environment.get(\"nome_titular\");",
                  "",
                  "const cardData = {",
                  "    \"card_number\": numCartao,",
                  "    \"expiration_month\": parseInt(mesExp),",
                  "    \"expiration_year\": parseInt(anoExp),",
                  "    \"security_code\": cvv,",
                  "    \"cardholder\": {",
                  "        \"name\": nomeTitular",
                  "    }",
                  "};",
                  "",
                  "const publicKey = pm.environment.get(\"public_key_teste\");",
                  "",
                  "pm.sendRequest({",
                  "    url: `https://api.mercadopago.com/v1/card_tokens?public_key=${publicKey}`,",
                  "    method: 'POST',",
                  "    header: {",
                  "        'Content-Type': 'application/json'",
                  "    },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify(cardData)",
                  "    }",
                  "}, function (err, res) {",
                  "    if (err) {",
                  "        console.log(\"Erro ao gerar token do MP: \", err);",
                  "    } else {",
                  "        const responseJson = res.json();",
                  "        const token = responseJson.id;",
                  "        ",
                  "        pm.collectionVariables.set(\"card_token_gerado\", token);",
                  "        console.log(\"Token gerado com sucesso: \" + token);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "",
